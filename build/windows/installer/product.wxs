<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX v3 source for the pgCowboy MSI installer.

  Compiled by build/scripts/make-msi.ps1 (candle + light), which supplies every
  $(var.*) below. UpgradeCode must stay stable forever — changing it breaks
  in-place upgrades of already installed copies.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="pgCowboy"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="Michal Bartak"
           UpgradeCode="{7B2A5C41-3E96-4D0B-9F17-C8D5A2E64B33}">

    <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of pgCowboy is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Pre-populate the install dir from a previous installation so upgrades land in place -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallPath"
                      Root="HKLM"
                      Key="Software\MichalBartak\pgCowboy"
                      Name="InstallPath"
                      Type="raw"
                      Win64="yes" />
    </Property>

    <Icon Id="AppIcon" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/michal-bartak/pgcowboy" />

    <!-- ── UI ─────────────────────────────────────────────── -->
    <!-- WIXUI_INSTALLDIR points at INSTALLFOLDER so the PathEdit shows the full default path -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <WixVariable Id="WixUIBannerBmp"  Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp"  Value="$(var.DialogBmp)" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />

    <UIRef Id="WixUI_InstallDir" />

    <!-- ── Layout ─────────────────────────────────────────── -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="pgCowboy" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="AppMenuFolder" Name="pgCowboy" />
      </Directory>
    </Directory>

    <ComponentGroup Id="MainFiles" Directory="INSTALLFOLDER">
      <Component Id="MainExe" Guid="*">
        <File Id="pgCowboyExe" Source="$(var.ExePath)" KeyPath="yes" />
      </Component>
      <Component Id="InstallPathRegistry" Guid="*">
        <RegistryValue Root="HKLM"
                       Key="Software\MichalBartak\pgCowboy"
                       Name="InstallPath"
                       Type="string"
                       Value="[INSTALLFOLDER]"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <DirectoryRef Id="AppMenuFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="AppShortcut"
                  Name="pgCowboy"
                  Description="Maintain PostgreSQL roles across many clusters"
                  Target="[INSTALLFOLDER]pgCowboy.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RemoveFolder Id="RemoveAppMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\MichalBartak\pgCowboy"
                       Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="MainFeature" Level="1">
      <ComponentGroupRef Id="MainFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

  </Product>
</Wix>
